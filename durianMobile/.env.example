# Base URL of the REST API
EXPO_PUBLIC_API_URL=https://api.example.com
# Use the in-memory mock API instead of the real backend
EXPO_PUBLIC_USE_MOCK=true
# Dev sign-in against a real backend (APP_ENV=dev). `dev:demo` = seeded household
# EXPO_PUBLIC_DEV_ID_TOKEN=dev:demo
# Google sign-in (web client ID is required to get an idToken; also goes in the backend's GOOGLE_CLIENT_IDS)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<id>.apps.googleusercontent.com
