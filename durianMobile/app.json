{
  "expo": {
    "name": "Sầu Riêng AI",
    "slug": "durianMobile",
    "scheme": "durian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.durianfarm.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần dùng camera để chụp ảnh cây, lá, trái và nhận diện bệnh.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để chọn ảnh lá, trái, thân cây và nhận diện bệnh.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.durianfarm.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1D5B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1D5B3A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần dùng camera để chụp ảnh cây và nhận diện bệnh."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để chọn ảnh lá, trái, thân cây và nhận diện bệnh."
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-sqlite",
      "onnxruntime-react-native",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.353834200795-82pgepighrng8kf3i76ul0krbim9no0e"
        }
      ]
    ]
  }
}
