# Template for /opt/saurieng-ai/production.env (mode 600, never committed).
# Keep the real file on the Mac as durianBackend/.env.production and send it with deploy/push-env.sh.

# "prod" disables the dev:<name> login. Never set dev in production.
APP_ENV=prod

# Services inside the compose network.
MONGO_URI=mongodb://mongo:27017/?directConnection=true
MONGO_DB=durian
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# MinIO: the API talks to it inside the network; phones and the admin web use the public host,
# which is baked into presigned URLs. The keys are also MinIO's root user/password.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://media-saurieng-ai.giaphuoccv.com
S3_BUCKET=durian-media
S3_REGION=us-east-1
S3_ACCESS_KEY=        # openssl rand -hex 12
S3_SECRET_KEY=        # openssl rand -hex 32

# Sign-in: JSON lists. Google must include the web client id the mobile build uses;
# Apple must include the iOS bundle id.
GOOGLE_CLIENT_IDS=["..."]
APPLE_CLIENT_IDS=["..."]
SESSION_TTL_DAYS=30

# LLM / RAG. Do not change the embedding model or EMBEDDING_DIM on an existing index.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
CHAT_RATE_LIMIT_PER_MIN=10
