          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "deleted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "season_id": {
            "type": "string",
            "format": "uuid",
            "title": "Season Id"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "photo_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Id"
          },
          "occurred_on": {
            "type": "string",
            "title": "Occurred On"
          },
          "kind": {
            "type": "string",
            "enum": [
              "watering",
              "fertilizing",
              "spraying",
              "pruning",
              "inspection",
              "treatment",
              "other"
