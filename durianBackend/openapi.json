        ]
      }
    },
    "/v1/admin/me": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin Me",
        "operationId": "adminMe",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Adminme"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/sync": {
      "post": {
        "tags": [
          "Household data"
        ],
        "summary": "Sync",
        "operationId": "sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              },
              "examples": {
                "create_farm": {
                  "summary": "Create a farm (expected_revision null = create)",
                  "value": {
                    "mutations": [
                      {
                        "mutation_id": "bbbbbbbb-0000-4000-8000-000000000001",
                        "ops": [
                          {
                            "entity": "farm",
                            "op": "upsert",
                            "id": "aaaaaaaa-0000-4000-8000-000000000001",
                            "data": {
                              "name": "Vườn thử Swagger",
                              "province": "Tiền Giang"
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "create_plot": {
                  "summary": "Create a plot under the farm above",
                  "value": {
                    "mutations": [
                      {
                        "mutation_id": "bbbbbbbb-0000-4000-8000-000000000002",
                        "ops": [
                          {
                            "entity": "plot",
                            "op": "upsert",
                            "id": "aaaaaaaa-0000-4000-8000-000000000002",
                            "data": {
                              "farm_id": "aaaaaaaa-0000-4000-8000-000000000001",
                              "name": "Lô 1",
                              "area_ha": "1.2"
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "update_farm": {
                  "summary": "Update farm (send the revision you last saw; wrong rev => conflict)",
                  "value": {
                    "mutations": [
                      {
                        "mutation_id": "bbbbbbbb-0000-4000-8000-000000000003",
                        "ops": [
                          {
                            "entity": "farm",
                            "op": "upsert",
                            "id": "aaaaaaaa-0000-4000-8000-000000000001",
                            "expected_revision": 1,
                            "data": {
                              "name": "Vườn đã đổi tên"
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "delete_plot": {
                  "summary": "Soft-delete (tombstone) a plot",
                  "value": {
                    "mutations": [
                      {
                        "mutation_id": "bbbbbbbb-0000-4000-8000-000000000004",
                        "ops": [
                          {
                            "entity": "plot",
                            "op": "delete",
                            "id": "aaaaaaaa-0000-4000-8000-000000000002",
                            "expected_revision": 1
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/snapshot": {
      "get": {
        "tags": [
          "Household data"
        ],
        "summary": "Snapshot",
        "description": "Everything the caller has had acknowledged, tombstones included.",
        "operationId": "getSnapshot",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AiConsentRequest": {
        "properties": {
          "version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Version",
            "description": "null withdraws consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version"
        ],
        "title": "AiConsentRequest"
      },
      "AuthSessionRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "apple"
            ],
            "title": "Provider"
          },
          "id_token": {
            "type": "string",
            "minLength": 1,
            "title": "Id Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "id_token"
        ],
        "title": "AuthSessionRequest",
        "examples": [
          {
            "id_token": "dev:demo:Demo Farmer",
            "provider": "google"
          }
        ]
      },
      "CareInputRow": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "active_ingredient": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Ingredient"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "product_name",
          "amount",
          "unit",
          "active_ingredient"
        ],
        "title": "CareInputRow"
      },
      "CareLog": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "revision": {
            "type": "integer",
