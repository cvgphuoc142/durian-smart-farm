            "title": "Updated At"
          },
          "deleted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "season_id": {
            "type": "string",
            "format": "uuid",
            "title": "Season Id"
          },
          "care_log_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Care Log Id"
          },
          "occurred_on": {
            "type": "string",
            "title": "Occurred On"
          },
          "category": {
            "type": "string",
            "enum": [
              "fertilizer",
              "plant_protection",
