            ],
            "title": "Category"
          },
          "amount_vnd": {
            "type": "string",
            "title": "Amount Vnd"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "revision",
          "created_at",
          "updated_at",
          "deleted_at",
          "season_id",
          "care_log_id",
          "occurred_on",
          "category",
