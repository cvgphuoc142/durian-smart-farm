          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "locale"
        ],
        "title": "LocaleRequest"
      },
      "Mutation": {
        "properties": {
          "mutation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Mutation Id"
          },
          "ops": {
            "items": {
              "$ref": "#/components/schemas/Op"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Ops"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
